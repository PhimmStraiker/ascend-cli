{
  "_comment": "Azure OpenAI (api-key). Replace <resource>/<deployment>; set $AZURE_OPENAI_KEY. Entra SP variant: example-azure-openai-entra.json.",
  "adapter": "direct_api",
  "endpoint": "https://<resource>.openai.azure.com/openai/deployments/<deployment>/chat/completions?api-version=2024-06-01",
  "method": "POST",
  "auth": {
    "type": "static",
    "mode": "api_key",
    "name": "api-key",
    "value": "env:AZURE_OPENAI_KEY"
  },
  "headers": {
    "Content-Type": "application/json"
  },
  "body": {
    "messages": [
      {
        "role": "user",
        "content": "{{PROMPT}}"
      }
    ]
  },
  "response_path": "choices.0.message.content",
  "timeout_ms": 60000
}